# Copy to .env (same folder as docker-compose.yml) and fill in.

# URL clients reach the server at (baked into tokens; use in the Obsidian plugin)
PUBLIC_BASE_URL=https://sync.example.com                                                           # how clients reach this server (baked into tokens)

# OIDC provider (register ${PUBLIC_BASE_URL}/auth/callback as the redirect URI)
OIDC_MODE=oidc
OIDC_ISSUER=https://id.example.com                                                                      # your PocketID base URL (no trailing slash)
OIDC_CLIENT_ID=<uuid from PocketID>
OIDC_CLIENT_SECRET=<secret shown once>
